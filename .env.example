# ==============================================================================
# AI Resume & Interview Coach - Environment Configuration
# ==============================================================================

# Backend API Configuration
PORT=8000
ENVIRONMENT=development
JWT_SECRET=ai_resume_super_secret_jwt_key_change_in_production_998877
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL or fallback SQLite)
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/ai_career_coach
# Default fallback: sqlite:///./ai_career_coach.db
DATABASE_URL=sqlite:///./ai_career_coach.db

# AI Provider Configuration
# Compatible with OpenAI, Groq, Ollama, DeepSeek, OpenRouter, Gemini (OpenAI compat)
# Example OpenAI: https://api.openai.com/v1, model: gpt-4o-mini or gpt-4o
# Example Groq: https://api.groq.com/openai/v1, model: llama-3.3-70b-versatile
# Example Ollama: http://localhost:11434/v1, model: llama3
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
